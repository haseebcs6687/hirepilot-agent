# ==============================================================================
# HirePilot Configuration (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or real API keys to version control.
# ==============================================================================

# Application Environment & Runtime
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///hirepilot.db

# Safety & Execution Controls
# dry_run: If true, drafts emails but never sends them (default: true)
DRY_RUN=true
# autopilot: If true, runs pipeline continuously in background (default: false)
AUTOPILOT=false
# kill_switch: If true, immediately halts all pipeline execution (default: false)
KILL_SWITCH=false

# LLM Providers (Free Tier APIs)
# Primary: Google Gemini Free API (Get key: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_RPM_LIMIT=15

# Fallback: Groq Free API (Get key: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_RPM_LIMIT=30

# Personal Profile & Sensitive Assets (Stored only in private/)
PROFILE_DIR=private
PROFILE_FILE=private/profile.yaml
CV_FILE=private/cv.md
WRITING_SAMPLES_DIR=private/writing_samples

# Gmail Integration (Phase 4 - stored in private/)
GMAIL_CREDENTIALS_PATH=private/credentials.json
GMAIL_TOKEN_PATH=private/token.json
GMAIL_SENDER_EMAIL=your.email@gmail.com

# Deliverability & Safeguards
DAILY_SEND_CAP=5
MIN_SEND_DELAY_SECONDS=180
MAX_SEND_DELAY_SECONDS=600
WORKING_HOURS_START=09:00
WORKING_HOURS_END=17:00
WORKING_TIMEZONE=UTC
WORKING_DAYS=0,1,2,3,4

# Server & Dashboard Ports
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501
